<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hh.pms.mapper.PpmLineItemsMapper">
    
    <resultMap type="PpmLineItems" id="PpmLineItemsResult">
        <result property="vid"    column="vid"    />
        <result property="vCode"    column="v_code"    />
        <result property="sid"    column="sid"    />
        <result property="jhId"    column="jh_id"    />
        <result property="aid"    column="aid"    />
        <result property="gid"    column="gid"    />
        <result property="vCount"    column="v_count"    />
        <result property="vPerson"    column="v_person"    />
        <result property="vPrice"    column="v_price"    />
        <result property="vTotal"    column="v_total"    />
        <result property="vDeliveryTime"    column="v_delivery_time"    />
        <result property="vDeliveryArea"    column="v_delivery_area"    />
        <result property="vIllustrate"    column="v_illustrate"    />
    </resultMap>

    <sql id="selectPpmLineItemsVo">
        select vid, v_code, sid, jh_id, aid, gid, v_count, v_person, v_price, v_total, v_delivery_time, v_delivery_area, v_illustrate from ppm_line_items
    </sql>

    <select id="selectPpmLineItemsList" parameterType="PpmLineItems" resultMap="PpmLineItemsResult">
        <include refid="selectPpmLineItemsVo"/>
        <where>
            <if test="vCode != null  and vCode != ''"> and v_code = #{vCode}</if>
            <if test="sid != null "> and sid = #{sid}</if>
            <if test="jhId != null "> and jh_id = #{jhId}</if>
            <if test="aid != null "> and aid = #{aid}</if>
            <if test="gid != null "> and gid = #{gid}</if>
            <if test="vCount != null "> and v_count = #{vCount}</if>
            <if test="vPerson != null  and vPerson != ''"> and v_person = #{vPerson}</if>
            <if test="vPrice != null "> and v_price = #{vPrice}</if>
            <if test="vTotal != null "> and v_total = #{vTotal}</if>
            <if test="vDeliveryTime != null "> and v_delivery_time = #{vDeliveryTime}</if>
            <if test="vDeliveryArea != null  and vDeliveryArea != ''"> and v_delivery_area = #{vDeliveryArea}</if>
            <if test="vIllustrate != null  and vIllustrate != ''"> and v_illustrate = #{vIllustrate}</if>
        </where>
    </select>

    <select id="selectPpmLineItemsByVid" parameterType="Long" resultMap="PpmLineItemsResult">
        <include refid="selectPpmLineItemsVo"/>
        where vid = #{vid}
    </select>

    <insert id="insertPpmLineItems" parameterType="PpmLineItems">
        insert into ppm_line_items
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="vid != null">vid,</if>
            <if test="vCode != null">v_code,</if>
            <if test="sid != null">sid,</if>
            <if test="jhId != null">jh_id,</if>
            <if test="aid != null">aid,</if>
            <if test="gid != null">gid,</if>
            <if test="vCount != null">v_count,</if>
            <if test="vPerson != null">v_person,</if>
            <if test="vPrice != null">v_price,</if>
            <if test="vTotal != null">v_total,</if>
            <if test="vDeliveryTime != null">v_delivery_time,</if>
            <if test="vDeliveryArea != null">v_delivery_area,</if>
            <if test="vIllustrate != null">v_illustrate,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="vid != null">#{vid},</if>
            <if test="vCode != null">#{vCode},</if>
            <if test="sid != null">#{sid},</if>
            <if test="jhId != null">#{jhId},</if>
            <if test="aid != null">#{aid},</if>
            <if test="gid != null">#{gid},</if>
            <if test="vCount != null">#{vCount},</if>
            <if test="vPerson != null">#{vPerson},</if>
            <if test="vPrice != null">#{vPrice},</if>
            <if test="vTotal != null">#{vTotal},</if>
            <if test="vDeliveryTime != null">#{vDeliveryTime},</if>
            <if test="vDeliveryArea != null">#{vDeliveryArea},</if>
            <if test="vIllustrate != null">#{vIllustrate},</if>
        </trim>
    </insert>

    <update id="updatePpmLineItems" parameterType="PpmLineItems">
        update ppm_line_items
        <trim prefix="SET" suffixOverrides=",">
            <if test="vCode != null">v_code = #{vCode},</if>
            <if test="sid != null">sid = #{sid},</if>
            <if test="jhId != null">jh_id = #{jhId},</if>
            <if test="aid != null">aid = #{aid},</if>
            <if test="gid != null">gid = #{gid},</if>
            <if test="vCount != null">v_count = #{vCount},</if>
            <if test="vPerson != null">v_person = #{vPerson},</if>
            <if test="vPrice != null">v_price = #{vPrice},</if>
            <if test="vTotal != null">v_total = #{vTotal},</if>
            <if test="vDeliveryTime != null">v_delivery_time = #{vDeliveryTime},</if>
            <if test="vDeliveryArea != null">v_delivery_area = #{vDeliveryArea},</if>
            <if test="vIllustrate != null">v_illustrate = #{vIllustrate},</if>
        </trim>
        where vid = #{vid}
    </update>

    <delete id="deletePpmLineItemsByVid" parameterType="Long">
        delete from ppm_line_items where vid = #{vid}
    </delete>

    <delete id="deletePpmLineItemsByVids" parameterType="String">
        delete from ppm_line_items where vid in
        <foreach item="vid" collection="array" open="(" separator="," close=")">
            #{vid}
        </foreach>
    </delete>
</mapper>